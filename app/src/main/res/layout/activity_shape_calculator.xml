<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Полотно для рисования фигур -->
    <com.example.camera_test.ShapeCanvasView
        android:id="@+id/shape_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/shape_spinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Контейнер для полей ввода СЛЕВА (стороны) -->
    <LinearLayout
        android:id="@+id/input_container_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#80FFFFFF"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/shape_canvas"
        app:layout_constraintTop_toTopOf="@id/shape_canvas"
        android:layout_margin="16dp">

        <!-- Поле для радиуса (круг) -->
        <LinearLayout
            android:id="@+id/field_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="r = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_radius"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <!-- Поле для диаметра (круг) -->
        <LinearLayout
            android:id="@+id/field_diameter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="d = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_diameter"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <!-- Поле для стороны квадрата -->
        <LinearLayout
            android:id="@+id/field_square_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="a = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_square_side"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <!-- Поля для прямоугольника -->
        <LinearLayout
            android:id="@+id/field_rect_width"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="a = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_rect_width"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_rect_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="b = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_rect_height"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <!-- Поля для равнобедренного треугольника -->
        <LinearLayout
            android:id="@+id/field_iso_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="a = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_iso_side"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_iso_base"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="b = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_iso_base"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <!-- Поля для прямоугольного треугольника -->
        <LinearLayout
            android:id="@+id/field_right_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="a = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_right_a"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_right_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="b = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_right_b"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_right_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="c = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_right_c"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <!-- Контейнер для углов СПРАВА (только для треугольников) -->
    <LinearLayout
        android:id="@+id/input_container_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#80FFFFFF"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/shape_canvas"
        app:layout_constraintTop_toTopOf="@id/shape_canvas"
        android:layout_margin="16dp">

        <!-- Углы для равнобедренного треугольника -->
        <LinearLayout
            android:id="@+id/field_iso_angle_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∠A = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_iso_angle_a"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_iso_angle_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∠B = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_iso_angle_b"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_iso_angle_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∠C = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_iso_angle_c"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <!-- Углы для прямоугольного треугольника -->
        <LinearLayout
            android:id="@+id/field_right_angle_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∠A = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_right_angle_a"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_right_angle_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∠B = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_right_angle_b"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/field_right_angle_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∠C = "
                android:textSize="14sp"
                android:textColor="#000000" />
            <EditText
                android:id="@+id/input_right_angle_c"
                android:layout_width="70dp"
                android:layout_height="36dp"
                android:inputType="numberDecimal"
                android:hint="0"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="#CCFFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <!-- Кнопка Solve -->
    <Button
        android:id="@+id/button_solve"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="Solve"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/results_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Контейнер для результатов -->
    <LinearLayout
        android:id="@+id/results_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#E3F2FD"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/shape_spinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/result_perimeter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P = "
            android:textSize="16sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/result_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S = "
            android:textSize="16sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/result_sides"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Выпадающий список для выбора фигуры -->
    <Spinner
        android:id="@+id/shape_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:background="@android:drawable/btn_dropdown"
        android:spinnerMode="dropdown"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>